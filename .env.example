# Python: autenticação e cadastro de conta.
VITE_API_BASE_URL=/api
# Java: CRUD de usuários/desafios e operações de grupos.
VITE_JAVA_API_BASE_URL=/api/java
# Destinos usados pelo Vite e pelo servidor de funcionários.
# Na Vercel, os destinos dos proxies estão definidos em vercel.json.
SOULUP_PYTHON_API_URL=https://soulup-api-python.onrender.com
# A senha de funcionários é definida em SOULUP_SENHA_FUNCIONARIOS no Render do Python.
# Não é configurada aqui nem em variáveis VITE_*.
SOULUP_JAVA_API_URL=https://challeng-sprin4-java.onrender.com
