{
  "framework": "vite",
  "buildCommand": "npm run build",
  "installCommand": "npm ci",
  "outputDirectory": "dist",
  "rewrites": [
    {
      "source": "/api/java/grupos",
      "destination": "/api/java-grupos"
    },
    {
      "source": "/api/auth/:action",
      "destination": "/api/auth?action=:action"
    },
    {
      "source": "/api/java/:path*",
      "destination": "https://challeng-sprin4-java.onrender.com/:path*"
    },
    {
      "source": "/api/:path*",
      "destination": "https://soulup-api-python.onrender.com/:path*"
    },

    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
